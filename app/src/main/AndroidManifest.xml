<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Shizuku 客户端权限：由 Shizuku server（adb/root 身份）在授权后授予本应用。 -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- 【包可见性·必须】SDK 30+ 默认查不到别的应用，这里要把两种形态都声明到：
         ① <package>：未隐身的老版 Shizuku 是固定包名 moe.shizuku.privileged.api，
            不声明的话 getPackageInfo / getLaunchIntentForPackage 都会被系统挡住，
            于是装了 Shizuku 却被误判成「未安装」。
         ② <intent>：新版「隐身 / 随机包名」会把 applicationId 改成 moe.shizuku.privileged.api.xxxx，
            固定包名查不到；但该 action 名不会被随机化，用它的持有者反查即可。
         两者缺一，就会在「另一种形态」的 Shizuku 上失灵。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="rikka.sui" />
        <intent>
            <action android:name="moe.shizuku.privileged.api.intent.action.REQUEST_PERMISSION" />
        </intent>
    </queries>
    <application
        android:name=".keepalive.DollhouseApp"
        android:allowBackup="false"
        android:extractNativeLibs="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <activity-alias
            android:name=".IconDefault"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.Material.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <!-- 【修·选图回调丢失】原 android:noHistory="true" 会让本页在被系统相册覆盖的瞬间
             被 finish 掉，选完图返回时 onActivityResult 永远收不到结果 —— 「聊天背景设了没反应」
             与「发图失效」是同一个根因。去掉该属性后本页可存活到结果投递完成，再自行 finish()。 -->
        <activity
            android:name=".PickFileActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 【背景裁剪】导入主题照片的中间页：选图 → 裁剪预览 → 按框落盘。
             theme 用 Manifest 声明（而不是代码 setTheme），否则窗口背景还是 Light 的
             浅色底，冷启动那一下会白闪。Translucent 会保留覆盖它的系统相册，
             与 PickFileActivity 同一套路。 -->
        <activity
            android:name=".BackgroundCropActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- 外部链接落地页：浏览器 / 自动化软件 / 终端 am start 都能拉起。
             dollhouse://pet/on | off | toggle
             com.dollhouse.app.action.PET_ON | PET_OFF | PET_TOGGLE
             只做一次启停转发，不显示界面，所以用 NoDisplay 主题（必须 onCreate 内 finish）。
             【关键】taskAffinity="" 让它自成独立任务，绝不能与 MainActivity 同任务栈 ——
             否则外部指令一触发，系统会把整个应用任务栈顶到前台，用户就被弹进 App 界面了。 -->
        <activity
            android:name=".PetLinkActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="dollhouse" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.dollhouse.app.action.PET_ON" />
                <action android:name="com.dollhouse.app.action.PET_OFF" />
                <action android:name="com.dollhouse.app.action.PET_TOGGLE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".PetService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="desktop pet floating overlay" />
        </service>
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- 【无感保活】覆盖安装后同样要恢复：JobScheduler 的 persisted 任务在包被替换时会被清掉。 -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- 【无感保活】常驻保活服务：保的是「本应用进程」，不是人偶。
             它在 onStartCommand 里挂一个 1×1 完全透明的悬浮窗（KeepAliveOverlay），
             把进程从「缓存进程」提升到「可见进程」，从而不容易被系统回收。
             与下面的 KeepAliveJobService / KeepAliveAlarmReceiver 互补：
             前者让进程不容易死，后两者负责被回收后拉回来。
             必须声明 specialUse 类型（targetSdk 34 起前台服务需显式类型）。 -->
        <service
            android:name=".keepalive.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="keep app process alive" />
        </service>
        <!-- 【无感保活】周期自检任务：JobScheduler 触发，落到 KeepAliveJobService。 -->
        <service
            android:name=".keepalive.KeepAliveJobService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
        <!-- 【无感保活】兜底闹钟：仅当厂商冻结 JobScheduler 时才用得上，6 小时一次。 -->
        <receiver
            android:name=".keepalive.KeepAliveAlarmReceiver"
            android:exported="false" />
        <!-- 快捷设置磁贴：状态跟随桌宠启停，点一下切换。
             必须声明 BIND_QUICK_SETTINGS_TILE 且 exported="true"，否则系统绑不上。 -->
        <!-- Shizuku 客户端 provider：server（adb/root）启动本应用时把 binder 推到这里。
             三个约束缺一不可：authorities 必须是自己的包名 + .shizuku（server 按此寻址）、
             exported 必须 true（server 在别的进程）、multiprocess 必须 false（否则拿错 uid）。
             声明 permission 是为了让这个 provider 只被本应用与 shell 身份访问。 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <service
            android:name=".PetTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_pet"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>