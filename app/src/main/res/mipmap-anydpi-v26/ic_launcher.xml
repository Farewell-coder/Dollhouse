<?xml version="1.0" encoding="utf-8"?>
<!-- Android 8.0+ 自适应图标。旧系统回落到 mipmap-*dpi/ic_launcher.png。

     【monochrome 必须是独立剪影，不能复用 foreground】
     它是 Android 13+「主题图标」用的：系统会把这一层按 alpha 提取，
     再按用户主题色重新着色。早先这里直接指向彩色前景图，
     系统拿到的是一整块不透明区域，主题图标会显示成一个糊掉的方块。
     现在指向 make_icons.py 生成的真·单色剪影。 -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
