<?xml version="1.0" encoding="utf-8"?>
<!-- 描边图标，风格参照 Lucide（ISC）。
     24dp 视口 / 线宽 2 / 圆角端点，strokeColor 运行期由 Icons.tint() 覆盖。
     【尺寸】内在尺寸 24dp→27dp：可见图形只有 22 个视口单位（=22dp），
             塞在 40dp 的圆形底板上偏小，放大 12.5% 后比例更协调。
             视口仍为 24×24，靠「多个 dp 对应同一个视口单位」实现放大，
             整条路径无需缩放、顶点坐标保持原样可读。
             换算：可见图形 22 × 1.125 = 24.75dp（原 22dp）。
     【居中】图形外框本来是居中的，但纸飞机的「墨」全压在右上（机头与两条长线），
             左下只剩两条细尾，视觉重心偏右上，看着像歪。
             实测墨量质心偏移 (+1.90,-1.90) 视口单位，故把整条路径平移 (-0.95,+0.95) 做光学补偿
             （optical correction），让墨量重心回到圆心附近。
             平移后含描边的范围 x[0.05,22.05] y[1.95,23.95]，四边都在视口内；
             取 0.95 已是上限，再往大挪圆角端帽就会被视口削掉。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="27dp"
    android:height="27dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M21.05,2.95 L10.05,13.95 M21.05,2.95 L14.05,22.95 L10.05,13.95 L1.05,9.95 Z"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
