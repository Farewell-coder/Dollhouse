<?xml version="1.0" encoding="utf-8"?>
<!-- 描边图标，取自 Lucide 官方 SVG（ISC 协议）。
     24dp 视口 / 线宽 2 / 圆角端点；strokeColor 为占位白，
     运行期由 Icons.get() / Icons.tint() 按主题覆盖真色。
     【用途】动作编辑页的「暂停」按钮（播放 ↔ 暂停 切换）。
     几何：两条竖线 x=10 与 x=14，y 从 5 到 19，视觉重心正好在 (12,12)。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M10 5v14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M14 5v14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>