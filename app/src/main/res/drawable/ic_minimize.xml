<?xml version="1.0" encoding="utf-8"?>
<!-- 描边图标，取自 Lucide 官方 SVG（ISC 协议）。
     24dp 视口 / 线宽 2 / 圆角端点；strokeColor 为占位白，
     运行期由 Icons.get() / Icons.tint() 按主题覆盖真色。

     【语义】minimize = 「缩小 / 收回来」，与 ic_maximize 成对。
     四个角的内折弧线：每个角从画布边缘往里收 3 个单位，
     包围盒 x∈[3,21]、y∈[3,21]，中心 (12,12)，与画布中心一致。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M 8 3 v 3 a 2 2 0 0 1 -2 2 H 3"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 21 8 h -3 a 2 2 0 0 1 -2 -2 V 3"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 3 16 h 3 a 2 2 0 0 1 2 2 v 3"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 16 21 v -3 a 2 2 0 0 1 2 -2 h 3"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>