<?xml version="1.0" encoding="utf-8"?>
<!-- 描边图标，取自 Lucide 官方 SVG（ISC 协议）。
     24dp 视口 / 线宽 2 / 圆角端点；strokeColor 为占位白，
     运行期由 Icons.get() 按参数覆盖真色。
     【用途】动作编辑页「上一帧」步进键：一条竖线 + 向左的尖角（skip-back 语义），
     与「前移一帧」（chevron-left，移动顺序）在语义上区分开。
     几何：竖线 x=7（y 5..19），尖角从 x=18 收到 x=10，整体中心 (12,12)。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M7 5v14"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M18 5L10 12l8 7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>