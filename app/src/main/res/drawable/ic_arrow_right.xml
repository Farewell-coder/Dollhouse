<?xml version="1.0" encoding="utf-8"?>
<!-- 描边图标，取自 Lucide 官方 SVG（ISC 协议）。
     24dp 视口 / 线宽 2 / 圆角端点；strokeColor 为占位白，
     运行期由 Icons.get() / Icons.tint() 按主题覆盖真色。

     【与 ic_arrow_left 的镜像关系】Lucide 的 arrow-left 是
       「m 12 19 -7 -7 7 -7」+「M 19 12 H 5」；
     本文件是它的 24 画布水平镜像（x → 24-x）：
       12→12、19→5、5→19，得到「m 12 19 7 -7 -7 -7」+「M 5 12 H 19」。
     包围盒 x∈[5,19]、y∈[5,19]，中心 (12,12)，与画布中心一致，无偏移。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="m 12 19 7 -7 -7 -7"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
    <path
        android:pathData="M 5 12 H 19"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000" />
</vector>
